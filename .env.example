# Optional. The market interval table builds from public MIS files with none of these set.
# Set all three to enable the ERCOT Public API archive (route 3): full AS demand-curve
# history, and forecast vintages older than the week MIS still keeps.
# The builder reads these variables. It does not write them anywhere.
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=

# Optional. Where raw downloads and the normalized store live. Default is data/ at the repo root.
# HARNESS_DATA_DIR=
